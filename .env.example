# --- Ung dung ---------------------------------------------------------------
APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Cong host (docker compose) ---------------------------------------------
APP_PORT=8080
FORWARD_DB_PORT=3307
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_PHPMYADMIN_PORT=8081
VITE_PORT=5173
# Dich vu danh cho phat trien (mailpit, phpmyadmin, vite). Bo dong nay khi deploy.
COMPOSE_PROFILES=dev

# --- Co so du lieu (MySQL 8) --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sms
DB_USERNAME=sms
DB_PASSWORD=secret
# Chi dung boi container mysql.
DB_ROOT_PASSWORD=root_secret

# --- Redis: cache, session, queue -------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Phien het han sau N phut khong hoat dong (FR-AUTH-02).
SESSION_LIFETIME=30
SESSION_ENCRYPT=false

# --- Mail (mailpit khi phat trien) ------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sms.local"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"

# --- Tai khoan Super Admin (de trong = khong tao; bat buoc dat khi deploy) -----
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_CODE=SUPERADMIN

# --- Quy tac nghiep vu (mac dinh nam trong config/sms.php) -------------------
SMS_API_ENABLED=false
SMS_LOGIN_MAX_ATTEMPTS=5
SMS_LOGIN_DECAY_SECONDS=60
SMS_GRADE_PASS_MIN=4.0
SMS_GRADE_RETAKE_POLICY=highest
SMS_MIN_CREDITS=14
SMS_MAX_CREDITS=24
SMS_ATTENDANCE_WINDOW_DAYS=7
SMS_ABSENCE_THRESHOLD=0.20
